# Committed production defaults for the FFD subdomain build (ffd.onlinebareed.com).
# Non-sensitive only: never put API secrets, tokens or credentials in this file,
# since anything here is bundled into the client-side JS and visible to users.
VITE_API_ENDPOINT=https://onlinebareed.com/sedresffd/api/
VITE_USE_MOCK_DATA=true
