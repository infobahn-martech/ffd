# FFD backend API base URL. Required — the app cannot reach any backend until this is set.
VITE_API_ENDPOINT=

# TEMPORARY dev-only mock data (see src/mocks/ffd/). true = local dummy
# workspaces/boards/cards + bypassed login, no backend needed. false = normal
# API flow via VITE_API_ENDPOINT. Delete this line entirely once the mock layer
# is removed for good.
VITE_USE_MOCK_DATA=false

# Google Maps JS API key (used by src/shared/hooks/useGoogleMaps.js). Optional.
VITE_GOOGLE_MAPS_API_KEY=

# Azure AD / MSAL app registration, for Microsoft sign-in (src/config/msalConfig.js). Optional.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
VITE_MICROSOFT_REDIRECT_URI=

# Support/contact URL for the Header's Help button (src/structure/Header/index.jsx).
# The button stays hidden until this is set. Optional.
VITE_SUPPORT_URL=
